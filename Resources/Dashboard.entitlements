<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Die gehärtete Laufzeitumgebung sperrt den Zugriff auf geschützte
         Daten, solange er nicht ausdrücklich angemeldet ist. Ohne diesen
         Eintrag bleibt der Kalender leer, auch wenn der Benutzer den
         Zugriff erlaubt hat. -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
</dict>
</plist>
